# Skopiuj ten plik do .env i uzupełnij wartości

# Wymagane przez komendy `flask db ...` (Flask-Migrate) - Flask CLI wczytuje ten
# plik automatycznie (dzięki python-dotenv), więc nie trzeba go ręcznie eksportować.
FLASK_APP=run.py

# Klucz sesji Flaska - zmień na losowy ciąg znaków w produkcji
SECRET_KEY=zmien-mnie-na-losowy-ciag-znakow

# Baza danych (domyślnie SQLite w instance/parkrun.db)
# DATABASE_URL=sqlite:///instance/parkrun.db

# Liczba nadchodzących sobót widocznych domyślnie w kalendarzu
UPCOMING_SATURDAYS_COUNT=8

# Dane wydarzenia
EVENT_NAME=parkrun Ogród Saski, Lublin
DEFAULT_MEETING_TIME=08:40
DEFAULT_RUN_TIME=09:00

# Konfiguracja SMTP (Flask-Mail). Jeśli MAIL_SUPPRESS_SEND=true,
# e-maile nie są wysyłane, tylko logowane w konsoli - wygodne do lokalnego developmentu.
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=wolontariat@parkrun-ogrodsaski.pl
